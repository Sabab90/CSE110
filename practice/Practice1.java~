import java.util.Scanner;
public class Practice1{
    public static void main(String [] args){
        Scanner sc= new Scanner(System.in);
        
        for(in i=0; i<=9; i++){
            init count=0;
            for(int j=0; count<=i; j++){
                if(j%i==0){
                    System.out.print(j+" ");
                    count++;
                }
            }
            
        }
    }
}